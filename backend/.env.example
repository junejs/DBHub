# DBHUB v1 backend environment variables.
# Copy to .env and fill in the secret-bearing entries before `make dev`.
# Non-secret entries can stay at their defaults.

# HTTP listen port (default 8080).
PORT=8080

# Platform PostgreSQL DSN. Required. Used by main.go for the metadata pool
# and by golang-migrate for schema migrations (16-ops §2).
DB_DSN=postgres://dbhub:dbhub@localhost:5432/dbhub?sslmode=disable

# JWT signing secret (HS256). Required. Inject via K8s Secret / orchestrator.
JWT_SECRET=change-me-in-development

# AES-256-GCM master key for at-rest credential encryption (D25, 16-ops §3).
# 32 bytes, base64-encoded. Required — the server refuses to start without a
# valid key. NEVER commit a real value.
# Generate one with: openssl rand -base64 32
MASTER_KEY=

# Log level (debug|info|warn|error) and format (json|text).
LOG_LEVEL=info
LOG_FORMAT=json

# First-admin bootstrap (16-ops §2, 16-ops §3 bcrypt cost 12).
# Empty values are allowed on empty DBs (logged as a warning); on a populated
# DB these env vars are no-ops. Never log or echo the password value.
# BOOTSTRAP_ADMIN_EMAIL=root@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-in-development

# Audit stdout mirror (D30 / 16-ops §5). When true, audit rows are also
# emitted as a single-line slog entry to stdout (truncated to 100KB).
AUDIT_STDOUT_MIRROR=false

# Rate limiting (16-ops §2).
RATE_QUERY_PER_USER_PER_MIN=60
RATE_LOGIN_PER_IP_PER_MIN=10

# Cache / timeouts (16-ops §2).
SCHEMA_CACHE_TTL=15m
QUERY_TIMEOUT=30s

# Async export threshold (D22).
EXPORT_SYNC_ROW_LIMIT=10000
EXPORT_RETENTION=24h